# ============================================================
# PUBLIC SITE
# ============================================================
NEXT_PUBLIC_SITE_URL=https://www.0thman.tech

# Add only after Google gives you a publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX


# ============================================================
# POSTGRESQL
# ============================================================
# Option A (recommended on Heroku / managed PostgreSQL):
DATABASE_URL=postgresql://username:password@hostname:5432/database

# Heroku / managed PostgreSQL requires SSL.
# Change to false only for a local PostgreSQL server that does not use TLS.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# Option B: use these instead of DATABASE_URL.
# If DATABASE_URL is set, the values below are ignored.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=portfolio
# PGUSER=portfolio_user
# PGPASSWORD=change-me


# ============================================================
# JWT ADMIN AUTHENTICATION
# ============================================================
# IMPORTANT: replace this with a random secret of AT LEAST 32 bytes.
# Example command:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-bytes

# Session lifetime in seconds. 86400 = 24 hours.
JWT_EXPIRES_IN_SECONDS=86400
JWT_ISSUER=0thman.tech
JWT_AUDIENCE=portfolio-admin
